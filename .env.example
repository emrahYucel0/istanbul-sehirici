# .env.example — ORTAM DEĞİŞKENİ SÖZLEŞMESİ
#
# Bu dosya DEPOYA GİRER ve hiçbir gerçek değer taşımaz. `.gitignore`
# `.env`i dışarıda tutarken bu dosyayı bilerek beyaz listeye alıyor
# (`!.env.example`) — çünkü yayına alırken cPanel ekranına elle girilecek
# değişkenlerin listesinin bir yerde durması gerekiyor ve tek kaynağı
# yayın belgesinin içindeki bir blok olmamalı.
#
# KULLANIM
#   cp .env.example .env      (Windows: copy .env.example .env)
#   sonra gerçek değerleri doldurun
#
# GERÇEK PAROLA/ANAHTAR BURAYA YAZILMAZ. `npm run sir-tara` derleme
# çıktısını ve depoyu tarıyor; bu dosyaya bir sır girerse orada yakalanır.

# ─────────────────────────────────────────────────────────────────────────
# ÜRETİMDE ZORUNLU
# ─────────────────────────────────────────────────────────────────────────

# Veritabanı bağlantısı.
# ÜRETİMDE host `localhost` olmalı: uygulama ile MySQL aynı makinede.
# Dış adres (cp66.servername.co gibi) hem yavaş hem cPanel > Remote MySQL
# üzerinden IP izni gerektirir.
DATABASE_URL="mysql://KULLANICI:PAROLA@localhost:3306/VERITABANI"

# Yönetici oturum çerezinin HMAC imza anahtarı.
# Uzun ve rastgele olmalı:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# TANIMSIZSA panele giriş 500 verir ve "AUTH_SECRET tanımlı değil" der —
# sessiz bir hata değildir, deneyerek görebilirsiniz.
# Yerelde `AUTH_SECRET`, cPanel'de `NUXT_AUTH_SECRET` adıyla girilir;
# ikisi de okunur (bkz. server/utils/auth.ts).
AUTH_SECRET=""

# `production` olmadan: HSTS başlığı gönderilmez ve oturum çerezi
# `Secure` işaretlenmez.
NODE_ENV="production"

# ─────────────────────────────────────────────────────────────────────────
# MAIL — YEDİSİ DE ZORUNLU
#
# Gömülü varsayılan YOK. Eksik alan uygulamayı çökertmez: iletişim formu
# talebi yine veritabanına yazılır, panelde `mailStatus: basarisiz` görünür
# ve hangi değişkenin eksik olduğu yazar.
#
# Değiştirmek için YENİDEN DERLEME GEREKMEZ — değerler istek anında
# okunuyor (server/mail/config.ts). Süreci yeniden başlatmak yeterli.
#
# ESKİ `NUXT_MAIL_SMTP_*` ADLARI ARTIK OKUNMUYOR.
# ─────────────────────────────────────────────────────────────────────────

MAIL_HOST=""
MAIL_PORT="587"
# Porttan çıkarım YAPILMIYOR; ne yazarsanız o. 465 genelde true, 587 false.
MAIL_SECURE="false"
MAIL_USER=""
MAIL_PASSWORD=""
# Gönderen adres. SPF/DKIM/DMARC hizası için sitenin alan adıyla AYNI
# alan adında olmalı; başka bir alan adı kullanmak teslimatı bozar.
MAIL_FROM=""
# Talep bildirimlerinin düşeceği kutu.
MAIL_TO=""

# ─────────────────────────────────────────────────────────────────────────
# İSTEĞE BAĞLI
# ─────────────────────────────────────────────────────────────────────────

# Derlemedeki varsayılanlar zaten doğru (nuxt.config.ts → site).
# Yalnız başka bir alan adına taşırken gerekir.
# NUXT_SITE_URL="https://istanbulevenakliyat.com"
# NUXT_SITE_NAME="İstanbul Eve Nakliyat"

# Hız sınırı sayaçlarının deposu.
# TANIMSIZSA sayaçlar SÜREÇ BELLEĞİNDE tutulur. Barındırma aynı uygulamadan
# birden fazla süreç açıyorsa her sürecin kendi sayacı olur ve gerçek sınır
# süreç sayısıyla çarpılır. Tek süreçli kurulumda fark yok.
# REDIS_URL="redis://127.0.0.1:6379"

# `mysqldump` / `mysql` PATH'te değilse yolları elle vermek için.
# Yalnız yedekleme ve geri yükleme betikleri kullanır.
# MYSQLDUMP_PATH="C:/Program Files/MySQL/MySQL Server 8.0/bin/mysqldump.exe"
# MYSQL_PATH="C:/Program Files/MySQL/MySQL Server 8.0/bin/mysql.exe"

# ─────────────────────────────────────────────────────────────────────────
# YALNIZ YEREL — ÜRETİME GİRMEZ
#
# `npm run seed` iki yönetici kullanıcı oluşturur. Üretim sunucusunda
# `prisma/` klasörü bulunmadığı için bu komut orada ÇALIŞTIRILAMAZ;
# yönetici hesapları veritabanı dökümüyle taşınır.
# ─────────────────────────────────────────────────────────────────────────

SEED_ADMIN_1_EMAIL=""
SEED_ADMIN_1_PASSWORD=""
SEED_ADMIN_2_EMAIL=""
SEED_ADMIN_2_PASSWORD=""
