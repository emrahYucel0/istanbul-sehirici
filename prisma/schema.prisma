// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Prisma 7: eski "prisma-client-js" üreteci yerine "prisma-client".
// Fark yalnızca isim değil — istemci artık node_modules/.prisma içine değil,
// projenin İÇİNE üretiliyor ve bu yüzden `output` zorunlu. Ayrıca Rust sorgu
// motoru ikilisi tamamen kalktı; Windows'ta dev server açıkken
// `prisma generate` çalıştırınca aldığımız EPERM kilidi bununla bitiyor.
generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

// Bağlantı adresi artık burada DEĞİL. Prisma 7'de `url` şemadan kaldırıldı:
// migrate/introspect komutları onu prisma.config.ts'ten, çalışma zamanı ise
// PrismaClient'a verilen driver adapter'dan alıyor (bkz. lib/prisma.ts).
datasource db {
  provider = "mysql"
}

model SiteSettings {
  id                  Int       @id @default(autoincrement())
  sectionName         String    @unique @default("site-settings")

  brandName           String?
  siteName            String?
  siteDescription     String?   @db.Text

  logo                String?
  favicon             String?
  ogImage             String?

  phone               String?
  mobilePhone         String?
  whatsAppNumber      String?
  email               String?
  address             String?   @db.Text

  facebookUrl         String?
  instagramUrl        String?
  twitterUrl          String?
  linkedinUrl         String?
  youtubeUrl          String?
  githubUrl           String?

  /// ÖLÜ ALANLAR — panelden KALDIRILDI (M6).
  ///
  /// Üçünün de herkese açık tüketicisi ölçüldü: SIFIR. Projede gtag, GTM
  /// veya dataLayer yükleyen hiçbir kod yok ve rıza (consent) altyapısı da
  /// yok. Panelde durdukları sürece "doldurdum, çalışıyor sanıyorum"
  /// üretiyorlardı. Sütunlar veri kaybı olmasın diye şemada bırakıldı;
  /// yönetim yüzeyinden çıkarıldılar. Rıza altyapısı kurulduğunda geri
  /// bağlanabilirler (bkz. M6 raporu).
  googleAnalyticsId   String?
  googleTagManagerId  String?
  googleAdsenseId     String?

  /// GENEL ÇAĞRI (CTA) — M6'da HeroPage'den DEVRALINDI.
  ///
  /// Eski sahibi `HeroPage` idi ve o modelin 12 alanından yalnız bu ikisi
  /// canlıydı: İstanbul dışı legacy bölge sayfalarının kapanış bandı
  /// (components/base/FinalCta.vue) onları okuyordu. İki alan için 12
  /// alanlık bir "Hero" paneli canlıymış gibi durmak, yöneticiye ana
  /// sayfayı oradan yönettiğini düşündürüyordu — oysa ana sayfa M4'ten beri
  /// HeroPage'i hiç okumuyor.
  ///
  /// Buraya taşındı çünkü SiteSettings zaten genel eylem verisinin sahibi
  /// (telefon, WhatsApp, adres). Değerler birebir kopyalandı; görünen
  /// metin ve adres değişmedi.
  ctaLabel            String?
  ctaLink             String?

  footerText          String?   @db.Text
  copyrightText       String?

  workingHours        String?   @db.Text
  googleMapsEmbed     String?   @db.Text

  /// Yapısal veri (MovingCompany) için konum. Google'ın yerel işletme
  /// sonuçlarında kullandığı `geo` alanını besler. Koordinat UYDURULAMAZ —
  /// yanlış konum işletmeyi yanlış yerde gösterir; bu yüzden boşken şemaya
  /// hiç eklenmez.
  latitude            Float?
  longitude           Float?

  /// Şemadaki `priceRange`. Serbest metin: "₺₺" ya da "6.000 - 21.000 TL".
  priceRange          String?

  metaTitle           String?
  metaDescription     String?   @db.Text
  metaKeywords        String?   @db.Text

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

//--------------------- NAVBAR-----------------------

model Navbar {
  id          Int                @id @default(autoincrement())
  sectionName String             @unique @default("navbars")
  logo        String?
  contacts    NavbarContacts[]
  socialLinks NavbarSocialLink[]
  createdAt   DateTime           @default(now())
}

model NavbarSocialLink {
  id       Int     @id @default(autoincrement())
  name     String?
  url      String?
  navbar   Navbar  @relation(fields: [navbarId], references: [id])
  navbarId Int
}

model NavbarContacts {
  id       Int     @id @default(autoincrement())
  phone    String?
  mail     String?
  address  String?
  navbar   Navbar  @relation(fields: [navbarId], references: [id])
  navbarId Int
}


//--------------------- HERO-----------------------

model HeroPage {
  id              Int       @id @default(autoincrement())
  sectionName     String    @unique @default("heros")
  title           String?
  subtitle        String?
  description     String?   @db.Text
  primaryButton   String?
  primaryLink     String?
  secondaryButton String?
  secondaryLink   String?
  image           String?
  backgroundImage String?

  /// Görsellerin alt metinleri. Boşsa component'teki varsayılan metin
  /// kullanılır — yani bu alanlar zorunlu değil, ÜSTÜNE YAZMA alanı.
  /// Görsel panelden değişebildiği için metni de panelde tutuyoruz;
  /// aksi halde resim değişince koda gömülü metin yanlış kalıyordu.
  imageAlt           String?
  backgroundImageAlt String?

  createdAt       DateTime? @default(now())
}


model Footer {
  id          Int      @id @default(autoincrement())
  sectionName String   @unique @default("footers")
  address     String?
  phone       String?
  email       String?
  copyright   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  socialLinks FooterSocialLink[]
  regionLinks FooterRegionLink[]
  quickLinks  QuickLink[]
  blogLinks   FooterBlogLink[]
}

model FooterSocialLink {
  id       Int     @id @default(autoincrement())
  name     String?
  url      String?
  footer   Footer  @relation(fields: [footerId], references: [id])
  footerId Int
}

model FooterBlogLink {
  id       Int     @id @default(autoincrement())
  name     String?
  url      String?
  footer   Footer  @relation(fields: [footerId], references: [id])
  footerId Int
}

model QuickLink {
  id       Int     @id @default(autoincrement())
  name     String?
  url      String?
  footer   Footer  @relation(fields: [footerId], references: [id])
  footerId Int
}

model FooterRegionLink {
  id       Int     @id @default(autoincrement())
  name     String?
  url      String?
  footer   Footer  @relation(fields: [footerId], references: [id])
  footerId Int
}

//--------------------- SERVICES / HİZMETLERİMİZ -----------------------

model Services {
  id               Int       @id @default(autoincrement())
  sectionName      String    @unique @default("services")
  mainTitle        String    // "Profesyonel Nakliye Hizmetlerimiz"
  description      String?   @db.Text // "Evden eve nakliyat sürecinizde..." açıklama paragrafı


  services         Service[]
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

//--------------------- TRUST BAR / GÜVEN BANDI -----------------------

/// Ana sayfada Hero'nun hemen altındaki güven bandı.
///
/// NEDEN AYRI BİR BÖLÜM
/// Bu içerik önceden `Services` modelinin içinde duruyordu (statsIntro +
/// statistics). Sebebi tarihseldi: güven bandı bir zamanlar hizmetler
/// bölümünün parçasıydı. Ana sayfadaki hizmetler bölümü kaldırıldıktan sonra
/// bu bağ tamamen anlamsızlaştı — panelde "Hizmetler" ekranını açan kişi
/// karşısında hiç ilgisi olmayan güven bandı alanlarını buluyordu.
/// Artık kendi bölümü ve kendi paneli var.
model TrustBar {
  id          Int            @id @default(autoincrement())
  sectionName String         @unique @default("trust-bar")

  /// Rakamların yanındaki kısa giriş paragrafı.
  intro       String?        @db.Text

  items       TrustBarItem[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model TrustBarItem {
  id         Int      @id @default(autoincrement())
  iconPath   String?
  /// "12+", "8.500+", "%100", "81"
  value      String
  /// Etiket iki satıra bölünüyor: "Yıllık" / "Deneyim"
  label1     String
  label2     String
  order      Int      @default(0)

  trustBar   TrustBar @relation(fields: [trustBarId], references: [id], onDelete: Cascade)
  trustBarId Int
}

model Service {
  id          Int      @id @default(autoincrement())
  imagePath   String   // "~/assets/images/ev-nakliye.png" gibi resim yolu
  /// Görselin alt metni. Boşsa "<başlık> çalışmamız" üretilir.
  /// Elle yazılması ÖNERİLİR: otomatik metin sayfayı tarif ediyor, resmi
  /// değil — görsel aramada karşılığı olan asıl yer burası.
  imageAlt    String?
  title       String   // "Evden Eve Nakliyat"
  subtitle    String?  // "Şehir İçi & Şehirlerarası"
  description String?  @db.Text // Daha detaylı açıklama (isteğe bağlı)

  /// Google arama sonucunda görünen açıklama. `excerpt`ten ayrı tutuluyor:
  /// excerpt sayfanın giriş paragrafı ve kart metni (doğal okunmalı), bu ise
  /// aramada tıklanma üretmeli. Boşsa excerpt'e düşülür.
  /// Google arama sonucunda görünen BAŞLIK. Boş bırakılırsa
  /// `başlık | marka` biçimi otomatik üretilir — yani bu alan doldurulmadan
  /// da hiçbir sayfa başlıksız kalmaz.
  ///
  /// Ayrı alan olmasının sebebi: sayfadaki H1 ile aramadaki başlığın aynı
  /// olması gerekmiyor. H1 sayfa içinde, bağlamı belliyken okunur; arama
  /// başlığı ise ~60 karakterlik bir vitrindir ve tek başına tıklanma
  /// üretmek zorundadır. Uzun yazı başlıklarında ikisi belirgin ayrışıyor.
  metaTitle       String?
  metaDescription String? @db.Text

  order       Int      @default(0) // Hizmetlerin sıralaması için

  // --- Kendi sayfası olan hizmetler --------------------------------------
  //
  // `slug` NULL OLABİLİR ve bu bilinçli: her hizmet karta çıkar ama her
  // hizmetin kendi sayfası olmaz.
  //
  // Somut örnek: "Evden Eve Nakliyat" kartı ana sayfada duruyor ama
  // /evden-eve-nakliyat diye bir sayfa AÇILMIYOR. Sebebi anahtar kelime
  // yamyamlığı: ana sayfa zaten bu baş terimi, 120 bölge sayfası da
  // "{yer} evden eve nakliyat" biçimini hedefliyor. Aynı terim için üçüncü
  // bir sayfa, Google'ın hangisini sıralayacağına karar verememesine ve
  // üçünün de zayıflamasına yol açar.
  //
  // Slug'ı olan hizmetler kök adreste yayınlanıyor (/asansorlu-nakliyat),
  // yazılar ve bölgelerle aynı desende (bkz. pages/[...slug].vue).

  slug        String?  @unique
  excerpt     String?  @db.Text // Kartta ve meta açıklamada görünen özet
  content     String?  @db.Text // Sayfa gövdesi (HTML)

  /** "Hizmete dahil olanlar" listesi: ["Ambalaj malzemesi", "Montaj-demontaj"] */
  includes    Json?

  /** Hizmete özgü sık sorulanlar: [{question, answer}] — FAQPage besler. */
  faqs        Json?

  // --- Yayın durumu -------------------------------------------------------
  //
  // NEDEN EKLENDİ
  // `slug` verilen her hizmet anında canlıydı: kök adreste sayfa açılıyor,
  // `/hizmetlerimiz` dizinine giriyor ve sitemap'e ekleniyordu. Yeni bir
  // hizmet taslak hâlde hazırlanamıyordu.
  //
  // DİKKAT — BU ALAN PANEL GÖVDESİNDEN YAZILMIYOR.
  // Bölüm kaydı her PUT'ta çocuk satırları silip yeniden yaratıyor
  // (services.config.ts → deleteStrategy: 'manual'). Yayın durumu genel
  // düzenleme gövdesinde taşınsaydı bir onay kutusu yayın kararını
  // geçersiz kılardı; taşınmasaydı her kayıtta sıfırlanırdı. Çözüm ikisi de
  // değil: durum güncelleme ÖNCESİ `slug` bazında okunup yeniden yazılıyor
  // ve yayına alma ayrı bir eylem (POST /api/services-yayin).
  //
  // Varsayılan `false`: yeni hizmet TASLAK başlar. Mevcut yedi hizmet göç
  // sırasında açıkça `true` yazıldı.
  isActive    Boolean  @default(false)

  services    Services @relation(fields: [servicesId], references: [id])
  servicesId  Int
}


//--------------------- PROCESS SECTION / NASIL ÇALIŞIYORUZ -----------------------
// Ana sayfaya derinlik katmak için eklendi: taşınma sürecini adım adım anlatan,
// arama niyetine ("nakliyat süreci nasıl işler" vb.) doğrudan hizmet eden ve
// müşterinin taşınma öncesi belirsizlik/kaygısını azaltan bir bölüm.

model ProcessSection {
  id          Int           @id @default(autoincrement())
  sectionName String        @unique @default("process-section")
  mainTitle   String        // "Taşınma Sürecimiz Nasıl İşliyor?"
  description String?       @db.Text // Açıklama paragrafı
  steps       ProcessStep[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ProcessStep {
  id               Int            @id @default(autoincrement())
  title            String         // "Ücretsiz Keşif ve Planlama"
  description      String         @db.Text // Adımın detaylı anlatımı
  iconPath         String?        // İkon/görsel yolu
  order            Int            @default(0) // Adım sırası (1,2,3...)

  /// ADIM ETİKETİ — "KEŞİF", "PAKETLEME".
  ///
  /// V2 Süreç bölümünde her adımın başlığının ÜSTÜNDE künye biçiminde bir
  /// etiket duruyor ve başlıktan farklı bir iş yapıyor: başlık bir cümle
  /// ("Önce hareketi değil, koşulları çıkarırız."), etiket ise adımın adı.
  /// `title` alanına sıkıştırılamaz.
  label            String?
  /// Adımın fotoğrafı. `iconPath` ikon içindi (V1 kart düzeni); V2 tam
  /// genişlikte fotoğraf kullanıyor. İkisi ayrı tutuluyor çünkü eski
  /// değerler silinmiyor.
  imagePath        String?
  /// Görselin alt metni. Otomatik üretilmiyor — yönetici yazıyor.
  imageAlt         String?
  /// Adımın altındaki isteğe bağlı bağlantı. V2'de yalnız bir adımda var;
  /// hangi adımda olduğunu koda gömmek yerine veriyle taşınıyor.
  linkLabel        String?
  linkHref         String?

  processSection   ProcessSection @relation(fields: [processSectionId], references: [id], onDelete: Cascade)
  processSectionId Int
}

//--------------------- WHY CHOOSE US / NEDEN BİZİ SEÇMELİSİNİZ -----------------------

model WhyChooseUs {
  id               Int      @id @default(autoincrement())
  sectionName      String   @unique @default("why-choose-us")
  mainTitle        String   // "Neden Evenakliye.com'u Tercih Etmelisiniz?"
  shortDescription String?  @db.Text // "Evden eve taşınma süreci..." paragrafı
  closingStatement String?  @db.Text // "Evenakliye.com ile taşınmanın ayrıcalığını yaşayın!"
  mainImage        String?  // Sağ taraftaki büyük resmin (why-choose-us-img.jpg) yolu
  /// Boşsa component'teki varsayılan metin kullanılır (bkz. HeroPage.imageAlt).
  mainImageAlt     String?
  features         WhyChooseUsFeature[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WhyChooseUsFeature {
  id          Int      @id @default(autoincrement())
  iconPath    String?  // "~/assets/images/shield.svg" gibi ikon yolu
  title       String   // "Sigortalı ve Güvenli Taşıma"
  description String?  @db.Text // Özellik açıklaması
  order       Int      @default(0) // Özelliklerin sıralaması için
  
  whyChooseUs   WhyChooseUs @relation(fields: [whyChooseUsId], references: [id])
  whyChooseUsId Int
}

//--------------------- WE HELP SECTION / YARDIM BÖLÜMÜ -----------------------

model WeHelpSection {
  id               Int              @id @default(autoincrement())
  sectionName      String           @unique @default("we-help-section")
  mainTitle        String           // "Evenakliye.com: Taşınma Sürecinizi Kolaylaştırıyoruz"
  description      String?          @db.Text // Açıklama paragrafı
  buttonText       String?          @default("Hizmetlerimizi İnceleyin")
  buttonLink       String?          @default("/hizmetlerimiz")
  features         WeHelpFeature[]
  images           WeHelpImage[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model WeHelpFeature {
  id              Int           @id @default(autoincrement())
  text            String        // "Ücretsiz Ekspertiz ve Detaylı Planlama"
  order           Int           @default(0) // Sıralama için
  
  weHelpSection   WeHelpSection @relation(fields: [weHelpSectionId], references: [id])
  weHelpSectionId Int
}

model WeHelpImage {
  id              Int           @id @default(autoincrement())
  imagePath       String        // "~/assets/images/img-grid-1.jpg"
  altText         String        // "Evenakliye.com profesyonel eşya paketleme görseli"
  position        String        // "grid-1", "grid-2", "grid-3" - görselin grid içindeki konumu
  order           Int           @default(0) // Görsel sıralaması
  
  weHelpSection   WeHelpSection @relation(fields: [weHelpSectionId], references: [id])
  weHelpSectionId Int
}


//--------------------- FAQ SECTION / SSS BÖLÜMÜ -----------------------

model FaqSection {
  id               Int              @id @default(autoincrement())
  sectionName      String           @unique @default("faq-section")
  mainTitle        String           // "Nakliye Sürecinizle İlgili Tüm Sorularınız"
  description      String?          @db.Text // "Evden eve nakliyat sürecinizle ilgili merak ettikleriniz..."
  ctaTitle         String?          @default("Başka sorunuz mu var?")
  ctaButtonText    String?          @default("Bize Ulaşın")
  ctaButtonLink    String?          @default("/iletisim")
  faqs             FaqItem[]
  statsCards       FaqStatsCard[]
  images           FaqImage[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model FaqItem {
  id              Int           @id @default(autoincrement())
  question        String        // "Nakliye öncesi eşyalarımı nasıl hazırlamalıyım?"
  answer          String        @db.Text // Ana cevap paragrafı
  order           Int           @default(0) // Sıralama için
  isActive        Boolean       @default(true) // Gösterim durumu
  
  details         FaqDetail[]
  
  faqSection      FaqSection    @relation(fields: [faqSectionId], references: [id], onDelete: Cascade)
  faqSectionId    Int
}

model FaqDetail {
  id              Int           @id @default(autoincrement())
  text            String        // "Kırılabilir eşyalar için köpük rulo ve özel karton kutular"
  order           Int           @default(0) // Sıralama için
  
  faqItem         FaqItem       @relation(fields: [faqItemId], references: [id], onDelete: Cascade)
  faqItemId       Int
}

model FaqStatsCard {
  id              Int           @id @default(autoincrement())
  value           String        // "150+"
  label           String        // "Profesyonel Ekip"
  bgColor         String        @default("#3b5d50") // Kart arka plan rengi
  textColor       String        @default("#ffffff") // Metin rengi
  position        String        // "top-right", "bottom-left" - kartın konumu
  order           Int           @default(0) // Sıralama için
  
  faqSection      FaqSection    @relation(fields: [faqSectionId], references: [id], onDelete: Cascade)
  faqSectionId    Int
}

model FaqImage {
  id              Int           @id @default(autoincrement())
  imagePath       String        // "~/assets/images/nakliye2.jpg"
  altText         String        // "Profesyonel Nakliye Ekibimiz"
  position        String        // "primary", "secondary" - görselin konumu (sol üst veya sağ alt)
  order           Int           @default(0) // Görsel sıralaması
  
  faqSection      FaqSection    @relation(fields: [faqSectionId], references: [id], onDelete: Cascade)
  faqSectionId    Int
}


//--------------------- PRICING SECTION / FİYATLANDIRMA BÖLÜMÜ -----------------------

model PricingSection {
  id               Int              @id @default(autoincrement())
  sectionName      String           @unique @default("pricing-section")
  mainTitle        String           // "Şeffaf Nakliyat Fiyatları"
  description      String?          @db.Text // Açıklama paragrafı
  pricingPlans     PricingPlan[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model PricingPlan {
  id               Int              @id @default(autoincrement())
  name             String           // "Ekonomik Taşıma", "Standart Taşıma", "Premium Taşıma"
  subtitle         String?          @db.Text // "Temel nakliye hizmeti", "Tam kapsamlı çözüm", "Beyaz eldiven hizmeti"
  price            String           // "1.499₺", "2.999₺", "4.499₺"
  priceSuffix      String?          @default("/başlangıç") // Fiyat son eki
  isPopular        Boolean          @default(false) // EN ÇOK TERCİH etiketi için
  isFeatured       Boolean          @default(false) // Öne çıkan plan (border ile vurgulu)
  buttonText       String           // "Detaylı Bilgi", "Hemen Teklif Al"
  buttonLink       String           // "/ekonomik-paket", "/standart-paket", "/premium-paket"
  buttonAriaLabel  String?          // Erişilebilirlik için aria-label
  features         PricingFeature[]
  order            Int              @default(0) // Sıralama için
  
  pricingSection   PricingSection   @relation(fields: [pricingSectionId], references: [id])
  pricingSectionId Int
}

model PricingFeature {
  id              Int           @id @default(autoincrement())
  text            String        // "1 oda eşya taşıma", "50 km'ye kadar ücretsiz"
  isIncluded      Boolean       @default(true) // Özellik dahil mi değil mi?
  order           Int           @default(0) // Özellik sıralaması
  
  pricingPlan     PricingPlan   @relation(fields: [pricingPlanId], references: [id])
  pricingPlanId   Int
}


//--------------------- QUOTE-----------------------

model QuoteRequest {
  id          Int       @id @default(autoincrement())
  sectionName String    @unique @default("quotes")
  subtitle    String?
  title       String?
  description String?   @db.Text
  phoneLabel  String?
  phone       String?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
}

//--------------------- TESTIMONIALS SECTION / MÜŞTERİ YORUMLARI BÖLÜMÜ -----------------------

model TestimonialSection {
  id               Int             @id @default(autoincrement())
  sectionName      String          @unique @default("testimonials-section")
  mainTitle        String          // "Müşterilerimizin Deneyimleri"
  subtitle         String?         @db.Text // "Evden eve nakliyat sürecimiz hakkında müşterilerimizin gerçek yorumları..."
  tag              String?         // "Müşteri Yorumları"
  testimonials     Testimonial[]
  showDecorations  Boolean         @default(true) // Dekoratif elementler gösterilsin mi?
  backgroundColor  String?         // Arkaplan rengi (varsayılan: beyaz)
  textColor        String?         // Yazı rengi (varsayılan: siyah)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Testimonial {
  id               Int             @id @default(autoincrement())
  customerName     String          // "Ahmet K.", "Ayşe T.", "Mehmet E."
  customerImage    String?         // "~/assets/images/testimonial.svg" veya müşteri fotoğrafı
  rating           Int             @default(5) // 1-5 arası yıldız sayısı
  comment          String          @db.Text // Müşteri yorumu metni
  date             DateTime        // Yorum tarihi
  location         String?         // "İstanbul", "Ankara'dan İzmir'e", "Ofis Taşıma"
  serviceType      String          // "Evden Eve Taşıma", "Şehirlerarası Nakliye", "Ofis Taşıma"
  serviceTypeIcon  String?         // İkon SVG path veya ikon adı
  isFeatured       Boolean         @default(false) // Öne çıkan yorum
  isActive         Boolean         @default(true) // Yorum aktif mi?
  order            Int             @default(0) // Sıralama

  // --- Siteden gelen yorumlar ------------------------------------------------
  //
  // Yorumlar iki kaynaktan geliyor: panelden elle girilenler ve ziyaretçilerin
  // formdan gönderdikleri. İkisi aynı listede gösteriliyor ama ziyaretçiden
  // gelen hiçbir yorum ONAY OLMADAN yayınlanmıyor.
  //
  // Bu sadece spam önlemi değil: yorumlar ileride Review/AggregateRating
  // yapısal verisini besleyecek ve Google doğrulanmamış/uydurma yorum
  // işaretlemesini ihlal sayıyor. Moderasyon bu yüzden zorunlu.

  /// false ise sitede GÖRÜNMEZ. Panelden girilen yorumlar true, siteden
  /// gelenler false olarak oluşuyor.
  isApproved       Boolean         @default(true)

  /// "admin" | "site" — moderasyon ekranında kaynağı ayırt etmek için.
  source           String          @default("admin")

  /// Yalnızca yönetici görür; gerektiğinde yorumu doğrulamak için.
  /// Herkese açık uçlardan ASLA döndürülmüyor.
  email            String?
  
  testimonialSection TestimonialSection @relation(fields: [testimonialSectionId], references: [id])
  testimonialSectionId Int
}

//--------------------- ABOUT SECTION / HAKKIMIZDA -----------------------

model AboutSection {
  id               Int      @id @default(autoincrement())
  sectionName      String   @unique @default("about-section")
  
  // Başlık ve Tanıtım
  // NOT — @db.Text: bu alanlar varsayılan VARCHAR(191) idi. 191 karakter
  // bir paragraf için yetmiyor (ana sayfadaki SSS cevapları 430-620
  // karakter) ve uzun metin sessizce reddediliyordu. Aynı sorun
  // FaqSection'da @db.Text ile çözülmüştü, burada da öyle.
  mainTitle        String   // "Nakliyat Sektörünün Güvenilir Adresi"
  description1     String   @db.Text // 1. paragraf
  description2     String   @db.Text // 2. paragraf
  description3     String   @db.Text // 3. paragraf
  
  // Hizmet Detayları
  services         AboutService[]
  
  // Full-width Resim
  teamImage        String   // "~/assets/images/team.jpg"
  teamImageAlt     String   // "Profesyonel Nakliyat Ekibimiz İş Başında"
  
  // Şirket Tarihçesi
  historyTitle     String   // "15 Yıllık Deneyimle Geleceğe Taşıyoruz"
  historyText1     String   @db.Text // 1. tarihçe paragrafı
  historyText2     String   @db.Text // 2. tarihçe paragrafı
  historyText3     String   @db.Text // 3. tarihçe paragrafı
  
  // İstatistikler
  stats            AboutStat[]
  
  // SEO ve Meta
  seoTitle         String   // "Hakkımızda | İstanbulun En Güvenilir Nakliyat Şirketi"
  seoDescription   String   // Meta description
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AboutService {
  id          Int      @id @default(autoincrement())
  iconPath    String   // "~/assets/images/shield.svg"
  iconAlt     String   // "Güvenli Taşıma"
  title       String   // "Sigortalı Taşıma"
  description String   @db.Text // Özellik açıklaması (bkz. AboutSection'daki @db.Text notu)
  order       Int      @default(0) // Sıralama
  
  aboutSection   AboutSection @relation(fields: [aboutSectionId], references: [id])
  aboutSectionId Int
}

model AboutStat {
  id          Int      @id @default(autoincrement())
  value       String   // "15+", "10K+", "20+", "24/7"
  label       String   // "Yıllık Deneyim", "Mutlu Müşteri", vb.
  order       Int      @default(0) // Sıralama
  
  aboutSection   AboutSection @relation(fields: [aboutSectionId], references: [id])
  aboutSectionId Int
}

//--------------------- POST-----------------------

model Post {
  id         Int       @id @default(autoincrement())
  title      String?
  subtitle   String?
  shortTitle String?
  author     String?
  slug       String?   @unique
  content    String?   @db.Text
  excerpt    String?   @db.Text

  /// Google arama sonucunda görünen açıklama. Bilgilendirici içerik olduğu
  /// için satış cümlesi DEĞİL, yazının cevapladığı soruyu vaat eder.
  /// Boşsa excerpt'e düşülür.
  /// Google arama sonucunda görünen BAŞLIK. Boş bırakılırsa
  /// `başlık | marka` biçimi otomatik üretilir — yani bu alan doldurulmadan
  /// da hiçbir sayfa başlıksız kalmaz.
  ///
  /// Ayrı alan olmasının sebebi: sayfadaki H1 ile aramadaki başlığın aynı
  /// olması gerekmiyor. H1 sayfa içinde, bağlamı belliyken okunur; arama
  /// başlığı ise ~60 karakterlik bir vitrindir ve tek başına tıklanma
  /// üretmek zorundadır. Uzun yazı başlıklarında ikisi belirgin ayrışıyor.
  metaTitle       String?
  metaDescription String? @db.Text

  image      String?
  /// Kapak görselinin alt metni. Boşsa "<kısa başlık> konulu yazının kapak
  /// görseli" üretilir. Elle yazılması önerilir (bkz. Service.imageAlt).
  imageAlt   String?

  // --- Yayın durumu -------------------------------------------------------
  //
  // NEDEN EKLENDİ
  // Bu modelde yayın durumu diye bir kavram YOKTU. Panelde bir yazıya
  // başlanıp yarım bırakıldığı anda o yazı canlıydı: kök adreste açılıyor,
  // `/blog` listesinde görünüyor, sitemap'e giriyor ve `index, follow`
  // etiketiyle dizine sunuluyordu. `Region`, `Neighborhood` ve `PolicyPage`
  // yayın durumu taşırken bu ailenin tek istisnası buydu.
  //
  // Varsayılan `false`: yeni kayıt TASLAK başlar. Mevcut on yazı göç
  // sırasında açıkça `true` yazıldı (bkz. migration) — hiçbiri yayından
  // düşmedi.

  /// Yayında mı. Herkese açık okumalar bunu süzüyor; `false` ise adres 404.
  isActive    Boolean   @default(false)

  /// İLK yayına alınma anı. Sonraki düzenlemeler ve yeniden yayınlar bu
  /// değeri DEĞİŞTİRMEZ — "ne zaman yayımlandı" sorusunun cevabı ilk
  /// yayındır, son dokunuş değil. Son düzenleme zaten `updatedAt`'ta.
  ///
  /// Yayından kaldırma bu alanı SİLMEZ: geçmiş korunuyor, aynı yazı geri
  /// alındığında özgün yayın tarihini kaybetmiyor.
  ///
  /// Herkese açık listede sıralama kaynağı da burası (bkz.
  /// posts.repository.ts). Önceden sıra veri tabanının doğal sırasıydı ve
  /// yalnız tesadüfen ters kronolojikti: on yazı en yeniden eskiye doğru
  /// eklendiği için `id` artışı tarih azalışıyla örtüşüyordu. Yeni bir
  /// yazı en büyük id'yi alacağı için listenin SONUNA düşerdi.
  publishedAt DateTime?

  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  /// Herkese açık her okuma `isActive` süzüyor. Bugün on kayıtta ölçülebilir
  /// bir kazanç yok; indeks yazı sayısı büyüdükçe anlam kazanıyor ve
  /// `Neighborhood.isActive` ile aynı deseni koruyor.
  @@index([isActive])
}

//--------------------- Region-----------------------

model Region {
  id         Int       @id @default(autoincrement())
  title      String?
  subtitle   String?
  shortTitle String?
  slug       String    @unique
  content    String?   @db.Text
  excerpt    String?   @db.Text

  /// Google arama sonucunda görünen açıklama.
  ///
  /// `excerpt`ten AYRI tutuluyor çünkü ikisinin işi farklı: `excerpt` sayfanın
  /// giriş paragrafı ve kart metni (doğal okunmalı), bu alan arama sonucunda
  /// tıklanma üretmeli (hizmet ifadesi + farklılaştırıcı + eylem çağrısı).
  /// Tek alan ikisini birden iyi yapamıyordu — ölçüldü: 120 excerpt'in
  /// HİÇBİRİNDE "evden eve nakliyat" ifadesi geçmiyordu.
  ///
  /// Boş bırakılırsa `excerpt`e düşülür; hiçbir sayfa açıklamasız kalmaz.
  /// Google arama sonucunda görünen BAŞLIK. Boş bırakılırsa
  /// `başlık | marka` biçimi otomatik üretilir — yani bu alan doldurulmadan
  /// da hiçbir sayfa başlıksız kalmaz.
  ///
  /// Ayrı alan olmasının sebebi: sayfadaki H1 ile aramadaki başlığın aynı
  /// olması gerekmiyor. H1 sayfa içinde, bağlamı belliyken okunur; arama
  /// başlığı ise ~60 karakterlik bir vitrindir ve tek başına tıklanma
  /// üretmek zorundadır. Uzun yazı başlıklarında ikisi belirgin ayrışıyor.
  metaTitle       String?
  metaDescription String? @db.Text

  image      String?

  /// Görselin alt metni. Boşsa "<bölge> evden eve nakliyat çalışmamız"
  /// üretilir.
  ///
  /// 120 bölgenin TAMAMINI doldurmak KASITLI OLARAK beklenmiyor: bölge
  /// görsellerinin çoğu aynı/benzer stok resim. Aynı fotoğraf için 120
  /// farklı açıklama yazmak hem yanıltıcı olur hem anahtar kelime
  /// doldurması sayılır. Otomatik metin zaten benzersiz ve dürüst.
  /// Bu alan, öne çıkarılan birkaç bölgeye özel görsel konduğunda kullanılır.
  imageAlt   String?

  isActive   Boolean   @default(false)
  cities     Json?     // İl bilgileri için JSON alanı
  
  // Yeni eklenen alanlar - Fiyat Faktörleri
  priceFactorsTitle   String?  // Tablo başlığı
  priceFactorsImage   String?  // Görsel URL
  priceFactors        Json?    // Faktörler dizisi [{factor: "Kaç odalı?", min: "10.000 TL", max: "25.000 TL"}]

  // --- Derinlik alanları -------------------------------------------------
  // Hepsi Json?; ilişki tablosu YAPILMADI çünkü bu alanların içine hiç
  // sorgu atılmıyor (filtreleme/sıralama yok), yalnızca kaydın kendisiyle
  // birlikte okunup yazılıyorlar. Mevcut `priceFactors` da aynı desende.
  //
  // Bu alanlar hem sayfa derinliğini (Google için ince içerik riskini
  // azaltmak) hem de yerel arama karşılıklarını besliyor.

  /**
   * Mahalle adları: ["Moda", "Yeldeğirmeni"] — yerel arama karşılığı.
   *
   * GEÇİŞ HÂLİNDE. Mahalleler artık kendi tablosunda (`Neighborhood`) da
   * duruyor ve sayfalar oradan okuyor. Bu alan SİLİNMEDİ: 473 adın tek
   * kaynağı olarak yıllardır paneldeydi ve import betiği (idempotent)
   * hâlâ buradan besleniyor. Hedef, `Neighborhood` tablosunun tek kaynak
   * olması; o zamana kadar ikisi birlikte duruyor.
   */
  neighborhoods Json?

  /// Bu ilçeye bağlı mahalle kayıtları. YALNIZ İstanbul ilçelerinde dolu.
  neighborhoodRecords Neighborhood[]

  /** Bölge künyesi: [{label: "Yapı dokusu", value: "1960-80 apartman"}] */
  facts Json?

  /** Sık sorulanlar: [{question, answer}] — FAQPage yapısal verisini besler. */
  faqs Json?

  /**
   * Sık taşınılan güzergâhlar: [{to: "Ataşehir", note: "..."}]
   * Hedefin slug'ı SAKLANMIYOR; render sırasında bölge adından çözülüyor.
   * Böylece panelden yanlış slug girilmesi mümkün olmuyor ve hedef bölge
   * silinirse bağlantı kırılmak yerine sessizce düz metne dönüyor.
   */
  routes Json?

  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

//--------------------- Neighborhood-----------------------

/// MAHALLE KAYDI.
///
/// NEDEN AYRI TABLO
/// Mahalleler `Region.neighborhoods` içinde yalnız AD olarak tutuluyordu.
/// Ad listesi gezinme için yetiyordu ama içerik üretimi için yetmiyor:
/// mahalle başına başlık, giriş, gövde, arama açıklaması, SSS ve yayın
/// durumu gerekiyor. Bunları tek bir JSON dizisine sıkıştırmak alan
/// bazında sorgu/süzme imkânını yok eder, kısmi güncelleme tüm diziyi
/// yeniden yazar ve panelde 17 mahallenin içeriğini tek alanda düzenlemek
/// pratikte kullanılamaz.
///
/// PARENT YALNIZ İSTANBUL İLÇESİ OLABİLİR
/// İlişki `Region`e bağlı çünkü ilçeler orada duruyor; ama İstanbul dışı
/// bir kayıt parent OLAMAZ. Bunu veri tabanı zorlayamıyor (aynı tabloda
/// hem il hem ilçe var), kural import betiği ve yayın kapısı tarafından
/// uygulanıyor — bkz. prisma/mahalle-aktar.mjs, prisma/mahalle-yayina-al.mjs.
model Neighborhood {
  id         Int      @id @default(autoincrement())

  districtId Int
  /// Bağlı olduğu İstanbul ilçesi. İlçe silinirse mahalleleri de gider —
  /// başka bir ilçeye "yetim" bağlanmaları anlamsız olurdu.
  district   Region   @relation(fields: [districtId], references: [id], onDelete: Cascade)

  /// Görünen ad, ek YOK: "Kaynarca". Başlıktaki "Mahallesi" eki
  /// shared/utils/mahalle.ts tarafından ekleniyor.
  name       String

  /// Adın slug'ı: "kaynarca". Bu bir ADRES DEĞİL, yalnız ilçe içi kimlik.
  slug       String

  /// YAYINDAKİ TAM ADRES: "kaynarca-mahallesi" ya da ad birden fazla
  /// ilçede geçtiği için "pendik-fevzi-cakmak-mahallesi".
  ///
  /// Değer BURADA ÜRETİLMİYOR: tek kaynak shared/utils/mahalle.ts.
  /// Sütun UNIQUE olduğu için çakışma politikası artık bir veri tabanı
  /// kısıtı — iki mahalle aynı adresi asla alamaz.
  canonicalPath String @unique

  /// Yayında mı. Import edilen kayıtlar PASİF başlar; yayın kapısından
  /// geçmeyen hiçbir kayıt aktifleşmiyor.
  isActive   Boolean  @default(false)

  title           String?
  excerpt         String?  @db.Text
  content         String?  @db.Text
  metaTitle       String?
  metaDescription String?  @db.Text

  /// Sık sorulanlar: [{question, answer}] — FAQPage yapısal verisini besler.
  faqs       Json?

  /// Mahalle künyesi: [{label, value}]. YALNIZ doğrulanmış bilgi girilir;
  /// "sokaklar dardır" gibi kaynaksız yerel iddia bu alana yazılmaz.
  facts      Json?

  imagePath  String?
  imageAlt   String?

  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  /// Aynı ilçede aynı ada iki kayıt olamaz.
  @@unique([districtId, slug])
  @@index([districtId])
  @@index([isActive])
}

//--------------------- Image-----------------------

model StoredFile {
  id           String    @id @default(uuid())
  originalName String?
  storedName   String    @unique
  mimeType     String?
  size         Int
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @updatedAt
}

//--------------------- User-----------------------

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String?
  role      String?   @default("user")
  createdAt DateTime? @default(now())
}

//--------------------- Meta-----------------------

model Meta {
  id          Int       @id @default(autoincrement())
  sectionName String    @default("metas")
  page        String?   @unique
  title       String?
  description String?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
}

//--------------------- Fiyat hesaplama aracı -----------------------

/// /fiyat-hesaplama sayfasındaki tahmin aracının katsayıları.
///
/// Bu değerler önce kodda sabitti. Panele açılmasının sebebi fiyatların
/// zamanla değişmesi — akaryakıt, işçilik ve sezon. Kod değişikliği ve yeni
/// dağıtım gerektirmeden güncellenebilmesi gerekiyor.
///
/// DİKKAT: burada girilen rakamlar müşteriye GÖSTERİLİYOR. Yanlış bir değer
/// yanlış fiyat beklentisi yaratır; panelde bu uyarı ayrıca yazılı.
model PriceEstimator {
  id                Int                       @id @default(autoincrement())
  sectionName       String                    @unique @default("price-estimator")

  /// Asansörsüz her kat için eklenen tutar (zemin ve 1. kat ücretsiz).
  floorFee          Int                       @default(450)
  /// Paketleme hizmeti seçilirse toplam bu katsayıyla çarpılır.
  packingMultiplier Float                     @default(1.18)
  /// Depolama seçilirse eklenen sabit tutar.
  storageFee        Int                       @default(3500)
  /// Gösterilen aralığın genişliği (yüzde). 15 → ±%15.
  rangePercent      Int                       @default(15)
  /// Sonuç bu katın katına yuvarlanır (500 → en yakın 500 TL).
  roundTo           Int                       @default(500)

  /// Sonucun altında görünen açıklama.
  note              String?                   @db.Text

  sizes             PriceEstimatorSize[]
  distances         PriceEstimatorDistance[]

  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

/// Ev büyüklüğü ve taban ücreti (şehir içi, asansörlü, zemin kat varsayımıyla).
model PriceEstimatorSize {
  id               Int            @id @default(autoincrement())
  /// Formda görünen metin: "2+1", "Ofis / İşyeri"
  label            String
  /// Taban ücret (TL)
  basePrice        Int
  order            Int            @default(0)

  estimator        PriceEstimator @relation(fields: [estimatorId], references: [id], onDelete: Cascade)
  estimatorId      Int
}

/// Mesafe kademesi ve çarpanı.
model PriceEstimatorDistance {
  id               Int            @id @default(autoincrement())
  /// "Aynı şehir içinde", "Komşu şehir (0–300 km)"
  label            String
  /// Taban ücret bu sayıyla çarpılır. Şehir içi genelde 1.
  multiplier       Float
  order            Int            @default(0)

  estimator        PriceEstimator @relation(fields: [estimatorId], references: [id], onDelete: Cascade)
  estimatorId      Int
}

//--------------------- Talepler ve dönüşüm ölçümü -----------------------

/// Siteden gelen iletişim/teklif talepleri.
///
/// Bu model neden var: form daha önce YALNIZCA mail atıyordu, hiçbir yere
/// kaydetmiyordu. SMTP'de bir aksama olduğunda (paylaşımlı hosting'de sık:
/// kapalı 587 portu, yanlış parola, sunucu limiti) müşteri adayı tamamen
/// kayboluyordu. Artık önce buraya yazılıyor, mail ondan sonra deneniyor —
/// mail başarısız olsa bile talep panelde duruyor.
///
/// `QuoteRequest` ile karıştırılmamalı: o, iletişim sayfasındaki teklif
/// bölümünün İÇERİĞİNİ tutan bir CMS kaydı, gelen talepleri değil.
model ContactLead {
  id         Int      @id @default(autoincrement())
  name       String
  email      String?
  phone      String?
  message    String?  @db.Text

  /// Talebin geldiği sayfa (örn. "/pendik"). 120 bölge sayfası olduğu için
  /// hangi içeriğin gerçekten müşteri getirdiğini ancak bu alan gösteriyor.
  sourcePage String?

  /// gonderildi | basarisiz | denenmedi — panelden SMTP sorunu görülebilsin.
  mailStatus String   @default("denenmedi")
  mailError  String?  @db.Text

  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([isRead])
}

/// Dönüşüm olayları: telefon ve WhatsApp tıklamaları.
///
/// Ziyaretçi SAYISI bilerek burada tutulmuyor — her sayfa görüntülemesini
/// MySQL'e yazmak paylaşımlı hosting'de en pahalı seçenek ve gereksiz, o iş
/// zaten bağlı olan Google Analytics'in. Burada yalnızca düşük hacimli ama
/// yüksek değerli olaylar var: sadece ilgilenen ziyaretçi telefonu tıklar.
model SiteEvent {
  id        Int      @id @default(autoincrement())

  /// telefon | whatsapp | form
  type      String

  /// Olayın gerçekleştiği sayfa — hangi bölge sayfasının dönüşüm getirdiğini
  /// bulmak için.
  page      String?

  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
}

//--------------------- Politika sayfaları --------------------------

/// Gizlilik Politikası, Kullanım Şartları ve Çerez Politikası metinleri.
///
/// NEDEN VERİTABANINDA
/// Üç metin de Vue bileşenlerinin ŞABLONUNA gömülüydü. İki sonucu vardı:
/// (1) yasal metni güncellemek kod değişikliği ve yeniden dağıtım
/// gerektiriyordu, (2) Gizlilik Politikası var olmayan bileşenleri
/// çağırdığı için sayfa CANLIDA TAMAMEN BOŞ basılıyordu ve bu fark
/// edilmemişti — şablona gömülü içerik hiçbir testin göremediği bir yer.
///
/// `slug` sayfanın adresiyle birebir aynı; yeni bir politika sayfası
/// eklemek için kayıt açmak ve sayfa dosyası oluşturmak yeterli.
model PolicyPage {
  id          Int       @id @default(autoincrement())

  /// Sayfa adresi: gizlilik-politikasi | kullanim-sartlari | cerez-politikasi
  slug        String    @unique

  /// Sayfadaki H1 başlığı.
  title       String

  /// Başlığın altındaki kısa açıklama. Boş bırakılabilir.
  subtitle    String?   @db.Text

  /// Zengin metin (HTML). Basılmadan önce sanitizeHtml'den geçirilir.
  content     String    @db.LongText

  /// "Son güncelleme" tarihi — ziyaretçiye gösterilir. Metin değişince
  /// admin'in elle güncellemesi gerekir; otomatik `updatedAt` KULLANILMAZ,
  /// çünkü bir yazım hatası düzeltmesi de yasal güncelleme gibi görünürdü.
  lastUpdated DateTime?

  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

//--------------------- ANA SAYFA (V2) — KONTROLLÜ İÇERİK ---------------------
//
// NEDEN AYRI BİR MODEL
//
// Ana sayfa V2'nin işletme metinleri bileşen dosyalarının içindeydi. Mevcut
// bölüm modelleri (HeroPage, WhyChooseUs, WeHelpSection…) eski markanın
// kart düzenine ait; alan adları benziyor ama semantikleri tutmuyor —
// örneğin V2 Hero'nun "ölçülen dört koşul"unun HeroPage'de karşılığı yok.
// Zorla genişletmek iki tasarımın alanlarını tek tabloda karıştırırdı.
//
// BU BİR SAYFA OLUŞTURUCU (PAGE BUILDER) DEĞİL
//
//   · `sectionKey` KAPALI bir küme — kod tarafında sabit (bkz.
//     server/domain/home/home.keys.ts). Yönetici yeni anahtar üretemiyor.
//   · Bölüm sırası, yerleşim, koreografi, künye numaraları, ızgara ve
//     erişilebilirlik yapısı KODDA kalıyor; her bölümün kendi bileşeni var.
//   · Öğe sayısı bölüm başına sabit (hero 4, kapsam 3, üç-istanbul 3,
//     fiyat 5). Yönetici öğe ekleyip düzeni bozamıyor.
//   · Alanlar isimlendirilmiş ve sınırlı; serbest "blok" listesi yok.
//
// Yani model, tasarımın izin verdiği DELİKLERİ temsil ediyor — tasarımın
// kendisini değil.

model HomeSection {
  id         Int      @id @default(autoincrement())

  /// Kapalı küme: hero | kapsam | uc-istanbul | hizmetler | fiyat | kapanis
  sectionKey String   @unique

  /// Bölümün ana başlığı (Hero'da H1, diğerlerinde H2).
  heading    String?  @db.Text
  /// Başlığın altındaki giriş paragrafı.
  lead       String?  @db.Text
  /// Listelerin üstündeki ikinci paragraf ("Her adres … dört soruyla
  /// ölçülür.", Kapsam'daki koşul notu).
  note       String?  @db.Text
  /// Bölümü kapatan vurgu cümlesi ("Aynı şehir. / Aynı taşıma değil.").
  closing    String?  @db.Text
  /// Vurgu cümlesinin altındaki açıklama paragrafı.
  closingNote String? @db.Text
  /// Bölümdeki eylem bağlantısının ETİKETİ. Hedef adres kodda: rota
  /// yapısının parçası ve `/iletisim` gibi sabit sayfalara gidiyor.
  ctaLabel   String?

  /// Bölümün ana görseli (Hero). Yükleme akışı mevcut FileUploader.
  imagePath  String?
  imageAlt   String?  @db.Text

  items      HomeSectionItem[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Bölümün SIRALI editoryal öğeleri.
///
/// Alanlar isimlendirilmiş ve hepsi isteğe bağlı; her bölüm ihtiyacı olan
/// alt kümeyi kullanıyor:
///   hero        label + body                      (ölçülen koşullar)
///   kapsam      label + body                      (örnek ilçe + koşulu)
///   uc-istanbul label + subLabel + title + body + imagePath + imageAlt
///   fiyat       label + body                      (fiyat faktörleri)
model HomeSectionItem {
  id        Int         @id @default(autoincrement())

  /// Küçük künye etiketi: "ARAÇ ERİŞİMİ", "DAR SOKAK", "Beşiktaş".
  label     String?
  /// Etiketin yanındaki ikincil künye: "Beşiktaş tipi".
  subLabel  String?
  /// Öğe başlığı (yalnız üç-İstanbul sahnelerinde).
  title     String?     @db.Text
  /// Öğe gövdesi.
  body      String?     @db.Text
  imagePath String?
  imageAlt  String?     @db.Text
  order     Int         @default(0)

  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId Int

  @@index([sectionId, order])
}


//--------------------- INTERNAL PAGE / İÇ SAYFA İÇERİĞİ -----------------------

/// İÇ SAYFA EDİTORYAL İÇERİĞİ — KONTROLLÜ CMS (M7).
///
/// Ana sayfa için M4'te `HomeSection` kuruldu; bu model onun iç sayfa
/// karşılığı. Aynı gerekçe: sayfanın YAPISI ve TASARIMI kodda kalıyor,
/// işletmenin normalde değiştirmesi gereken METİN ve GÖRSELLER veri
/// tabanına geçiyor.
///
/// SAYFA OLUŞTURUCU DEĞİL. `pageKey` ve `sectionKey` kapalı kümeler
/// (shared/utils/ic-sayfa.ts) ve sunucu bilinmeyen anahtarı reddediyor.
/// Yönetici yeni sayfa açamaz, yeni bölüm ekleyemez, bölüm sırasını
/// değiştiremez, öğe sayısını değiştiremez.
///
/// BURAYA YAZILMAYANLAR — her biri kendi sahibinde kalıyor:
///   SEO başlık/açıklama        Meta(page)
///   telefon/adres/saatler      SiteSettings
///   hizmet envanteri           Service
///   ilçe sayıları              Region'dan türetiliyor
///   fiyat katsayıları          PriceEstimator
///   yazı listesi               Post
model InternalPageSection {
  id         Int    @id @default(autoincrement())
  /// Kapalı küme: hizmetler · bolgeler · hakkimizda · iletisim · fiyat · blog
  pageKey    String
  /// Sayfaya özgü kapalı küme (bkz. shared/utils/ic-sayfa.ts).
  sectionKey String

  heading   String? @db.Text
  lead      String? @db.Text
  note      String? @db.Text
  closing   String? @db.Text

  /// Sahne fotoğrafı. `/images/...` (kaynak koddaki statik varlık) ya da
  /// `/yuklemeler/...` (yönetici yüklemesi) olabilir.
  imagePath String?
  /// ALT METİN SAYFA BAĞLAMINA AİTTİR, dosyaya değil: aynı fotoğraf başka
  /// bir sayfada başka bir şey anlatabilir. Bu yüzden medya kütüphanesinde
  /// değil, içeriğin yanında duruyor.
  imageAlt  String? @db.Text

  items     InternalPageItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageKey, sectionKey])
}

model InternalPageItem {
  id        Int     @id @default(autoincrement())
  label     String? @db.Text
  title     String? @db.Text
  body      String? @db.Text
  /// Dördüncü metin yuvası. Ölçülmüş tek bir ihtiyaç için var: hizmet
  /// dizinindeki örnek durumların altındaki "Evden Eve Nakliyat + Eşya
  /// Depolama" rozeti. Mevcut alanlardan birine sıkıştırmak (ör. alt metne)
  /// anlamı bozardı.
  note      String? @db.Text
  imagePath String?
  imageAlt  String? @db.Text
  order     Int     @default(0)

  section   InternalPageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId Int

  @@index([sectionId, order])
}
